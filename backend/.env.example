# FastAPI Project Configuration
PROJECT_NAME="IMPO Digital Studio Backend"
ENVIRONMENT="production"  # development | production

# Database URLs (Neon PostgreSQL / Supabase)
# DATABASE_URL: Pooled connection string used by FastAPI application
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/impodb?sslmode=require"
# DIRECT_URL: Direct unpooled connection string used by Alembic migrations
DIRECT_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/impodb?sslmode=require"

# Security & Authentication
# CRITICAL: Generate a 32+ byte random secret key for production (e.g. `openssl rand -hex 32`)
SECRET_KEY="generate_a_secure_random_32_byte_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Initial Admin Registration Defaults
ADMIN_EMAIL="admin@impodigitalstudio.com"
ADMIN_PASSWORD="set_strong_admin_password_here"

# CORS & Site Domain Configurations
# Production Admin Panel URL (Vercel)
ADMIN_SITE_URL="https://impoo-digital-studio.vercel.app"
# Production Public Website URL (Vercel)
PUBLIC_SITE_URL="https://impoo-digital-studio-c7n1-gilt.vercel.app"
# Comma-separated list for any additional allowed CORS origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,https://impoo-digital-studio.vercel.app,https://impoo-digital-studio-c7n1-gilt.vercel.app"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ==============================================================================
# IMPO DIGITAL STUDIO - BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# App Core Settings
PROJECT_NAME="IMPO Digital Studio Backend"
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# NEON POSTGRESQL DATABASE CONNECTION STRINGS (Mandatory sslmode=require)
# ------------------------------------------------------------------------------
# 1. DATABASE_URL: Pooled Connection String (Used by runtime FastAPI application)
#    Find in Neon Console under: Connection Details -> Pooled Connection
DATABASE_URL=postgresql://neondb_owner:npg_TJNIrKz1cXl8@ep-noisy-hill-av81gafu-pooler.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://neondb_owner:npg_TJNIrKz1cXl8@ep-noisy-hill-av81gafu.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# 2. DIRECT_URL: Direct (Unpooled) Connection String (Used by Alembic Migrations)
#    Find in Neon Console under: Connection Details -> Direct Connection
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
SECRET_KEY=replace_with_a_secure_32_byte_hex_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Initial Admin Credentials (Used by seed script)
ADMIN_EMAIL=admin@impodigitalstudio.com
ADMIN_PASSWORD=admin123

# CORS Allowed Origins
PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SITE_URL=http://localhost:3001

# Cloudinary Integration Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

